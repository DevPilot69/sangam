NODE_ENV=development
# Do not set PORT on Render — the platform injects it automatically.
PORT=4000
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated extra origins (Vercel previews are auto-allowed when FRONTEND_URL is *.vercel.app)
# CORS_EXTRA_ORIGINS=https://custom-domain.com

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vetan?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-min-32-chars-for-development-only
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-dev
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Optional integrations (validated at startup; use placeholders locally)
AWS_S3_BUCKET=dev-placeholder
SENDGRID_API_KEY=SG.placeholder

# Razorpay — https://dashboard.razorpay.com (placeholders enable mock subscribe in dev)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
BILLING_TRIAL_DAYS=14

# Log OTP / skip email verification gate on login (development only — never true on Render)
DEV_AUTH_VERBOSE=true
